# Optional: only needed if Netlify Blobs isn't auto-configured in functions.
# Project ID is under Site configuration → General → Project information.
# Token: Netlify user settings → Applications → Personal access tokens.
# NETLIFY_SITE_ID=
# NETLIFY_AUTH_TOKEN=

# Password for /admin (production: at least 8 characters — required)
ADMIN_PASSWORD=change-me-to-a-long-password

# REQUIRED in production: random string, at least 16 characters.
# Used to sign cookies and encrypt stored Gmail / Google tokens.
# Generate one: openssl rand -base64 32
ADMIN_SECRET=change-me-to-a-long-random-string

# Optional: unlock detailed /api/health diagnostics without admin login
# HEALTH_SECRET=

# Gmail account that sends guests their QR entry pass (optional if using dashboard form).
# GMAIL_APP_PASSWORD is a Google "app password" (needs 2-Step Verification),
# not your normal Gmail password.
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=

# Public address of the site. The QR code links here, so the phone scanning
# at the door must be able to open it.
SITE_URL=http://localhost:3000

# Password for the /door scanner page. Door staff can only scan passes;
# they can't see or edit the guest list. The admin password also works there.
DOOR_PASSWORD=

# "Sign in with Google" on the dashboard, so passes are sent from your Gmail.
# Create these in Google Cloud Console → APIs & Services → Credentials →
# OAuth client ID (Web application). Authorised redirect URI:
#   <SITE_URL>/api/admin/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
